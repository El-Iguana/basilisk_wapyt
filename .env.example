# Copy to .env and edit before running.

# ── First run ────────────────────────────────────────────────────────────────
# Used only when the users table is empty. Without BASILISK_ADMIN_PASS the
# password is change_me. Either way Basilisk asks for a new password on every
# load until it is changed in the app.
BASILISK_ADMIN_USER=admin
BASILISK_ADMIN_PASS=change-me-before-exposing

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite database, secret.key and session.key live here. Leave it unset: the
# container uses /data (its volume) and a local run uses ./data. A value here
# would override the container's /data and put the database outside the
# volume, where recreating the container loses it.
# BASILISK_DATA_DIR=./data

# The only folder SQLite connections may open files in. Default: the sqlite
# folder inside the data directory (container: /data/sqlite).
# BASILISK_SQLITE_ROOT=./data/sqlite

# Fernet key for credential encryption. Generated into secret.key on first run
# if unset. Back up whichever you use: losing it loses every stored password.
# BASILISK_SECRET_KEY=

# ── Service ──────────────────────────────────────────────────────────────────
# PORT=8768
# Loopback address Basilisk is reached on (a literal IP: pytincture serves
# authenticated plain HTTP only on loopback).
# BASILISK_HOST=127.0.0.1
# Address uvicorn listens on. 0.0.0.0 by default (right inside a container);
# for a local run, keep it on loopback:
BASILISK_BIND=127.0.0.1

# The server asks GitHub's releases API whether a newer Basilisk is out (one
# request per 6 hours, shown in About). off = never.
# BASILISK_UPDATE_CHECK=off

# Behind a TLS-terminating reverse proxy: the public origin and host name.
# BASILISK_CANONICAL_ORIGIN=https://sql.example.com
# BASILISK_ALLOWED_HOSTS=sql.example.com
